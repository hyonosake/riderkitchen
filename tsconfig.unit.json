{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.unit.tsbuildinfo",
    "target": "es2023",
    "lib": [
      "ES2023",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "esnext",
    "moduleResolution": "bundler",
    "types": [
      "node",
      "vite/client"
    ],
    "skipLibCheck": true,
    /* Юнит-тесты — по образцу e2e (те же флаги) + jsx для .tsx-тестов
       (Testing Library в R4–R6). Типы vitest приходят явным импортом
       из 'vitest' — globals выключены (vite.config.ts, test.globals). */
    "strict": true,
    "noEmit": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "jsx": "react-jsx",
    /* Linting */
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": [
    "tests/unit"
  ]
}